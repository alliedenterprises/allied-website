DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/allied_site
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Production (EC2 / PM2): also set NODE_ENV=production and PORT=3002.
#
# The site URL is NOT an environment variable. Canonical URLs, metadataBase, Open Graph, sitemap.xml,
# robots.txt and JSON-LD all use `domain` in src/content/company.ts (https://alliedeprs.com), so a
# missing or wrong server variable can never point canonicals at localhost or a preview host.
# Payload `serverURL` is left unset on purpose: setting it makes media URLs absolute, which
# next.config.ts `images.localPatterns` would not allow.
#
# Never set VERCEL=1 on the production server: it switches robots.txt and X-Robots-Tag to noindex.
